{
  "name": "blotato-comments",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "start": "node dist/src/main.js",
    "dev": "ts-node src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "jest --runInBand",
    "test:db": "tsx test/database.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/*.ts\" *.json *.cjs *.yaml README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/*.ts\" *.json *.cjs *.yaml README.md"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.0",
    "dotenv": "^16.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prisma": "6.19.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
